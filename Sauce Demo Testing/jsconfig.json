{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false
  },
  "include": [
    "pageObjects/**/*.js",
    "tests/**/*.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "allure-results",
    "allure-report"
  ]
}
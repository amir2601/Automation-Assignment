{
  "info": {
    "_postman_id": "27a9bef5-312b-4993-8597-fa739e840fb4",
    "name": "API Automation",
    "description": "API Automation collection for Reqres.in testing covering Authentication, CRUD operations, and Bad Requests with assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Q3 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status Code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Capture authToken\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"token\");",
              "    pm.collectionVariables.set(\"authToken\", response.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Logs in with registered credentials and captures the authToken into collection variables."
      },
      "response": []
    },
    {
      "name": "Q4 - Get User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify Name and Email match\", () => {",
              "    pm.expect(response.data.first_name).to.eql(\"Janet\");",
              "    pm.expect(response.data.last_name).to.eql(\"Weaver\");",
              "    pm.expect(response.data.email).to.eql(\"janet.weaver@reqres.in\");",
              "});",
              "",
              "// Store data for subsequent requests and bad request scenarios",
              "pm.collectionVariables.set(\"storedUserId\", response.data.id.toString());",
              "pm.collectionVariables.set(\"storedUserEmail\", response.data.email);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Gets user details by userId and verifies name and email."
      },
      "response": []
    },
    {
      "name": "Q5 - Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify updatedAt timestamp exists and is not empty\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"updatedAt\");",
              "    pm.expect(response.updatedAt).not.to.be.empty;",
              "});",
              "",
              "pm.test(\"Verify updated fields match request body\", () => {",
              "    pm.expect(response.name).to.eql(\"morpheus\");",
              "    pm.expect(response.job).to.eql(\"zion resident\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"morpheus\",\n  \"job\": \"zion resident\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "PUT request to update profile, verifying both updatedAt timestamp and the updated name and job fields."
      },
      "response": []
    },
    {
      "name": "Q6 - Patch field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify patched field changed\", () => {",
              "    pm.expect(response.job).to.eql(\"zion resident\");",
              "});",
              "",
              "pm.test(\"Verify only that field changed (other fields like name remain untouched)\", () => {",
              "    pm.expect(response).to.not.have.property(\"name\");",
              "});",
              "",
              "pm.test(\"Verify updatedAt timestamp is present\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"updatedAt\");",
              "    pm.expect(response.updatedAt).not.to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"job\": \"zion resident\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "PATCH request modifying a single field, verifying only that field changed and others were untouched."
      },
      "response": []
    },
    {
      "name": "Q8 - Bad Request - Login Missing Password (Stored Data)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Verify error message indicates missing password\", () => {",
              "    pm.expect(response).to.have.property(\"error\", \"Missing password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{storedUserEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Executes a 400 Bad Request using the stored user email without a password."
      },
      "response": []
    },
    {
      "name": "Q8 - Bad Request - Register Missing Password (Stored Data)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Verify error message for missing registration password\", () => {",
              "    pm.expect(response).to.have.property(\"error\", \"Missing password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{storedUserEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Executes a 400 Bad Request registration using the stored email without password."
      },
      "response": []
    },
    {
      "name": "Q8 - Bad Request - User Not Found (Stored Data)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let baseId = pm.collectionVariables.get(\"storedUserId\") || \"2\";",
              "pm.collectionVariables.set(\"invalidUserId\", baseId + \"999\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{invalidUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{invalidUserId}}"
          ]
        },
        "description": "Executes a 404 Not Found request deriving an invalid user ID dynamically from the stored user ID."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reqres.in/api"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "storedUserId",
      "value": "2"
    },
    {
      "key": "storedUserEmail",
      "value": "eve.holt@reqres.in"
    },
    {
      "key": "invalidUserId",
      "value": "2999"
    }
  ]
}
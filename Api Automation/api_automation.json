{
  "info": {
    "_postman_id": "27a9bef5-312b-4993-8597-fa739e840fb4",
    "name": "API Automation",
    "description": "Postman collection for testing Reqres.in API endpoints, covering authentication, CRUD operations, and negative test cases using stored variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login and Capture Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Capture authToken\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"token\");",
              "    pm.collectionVariables.set(\"authToken\", response.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eve.holt@reqres.in\",\n  \"password\": \"cityslicka\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Login using registered credentials and save authToken to collection variables."
      },
      "response": []
    },
    {
      "name": "Get User Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify Name and Email match\", () => {",
              "    pm.expect(response.data.first_name).to.eql(\"Janet\");",
              "    pm.expect(response.data.last_name).to.eql(\"Weaver\");",
              "    pm.expect(response.data.email).to.eql(\"janet.weaver@reqres.in\");",
              "});",
              "",
              "pm.collectionVariables.set(\"storedUserId\", response.data.id.toString());",
              "pm.collectionVariables.set(\"storedUserEmail\", response.data.email);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Fetch user by ID and store user information for next requests."
      },
      "response": []
    },
    {
      "name": "Update User Profile (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify updatedAt timestamp is present\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"updatedAt\");",
              "    pm.expect(response.updatedAt).not.to.be.empty;",
              "});",
              "",
              "pm.test(\"Verify updated fields match request\", () => {",
              "    pm.expect(response.name).to.eql(\"morpheus\");",
              "    pm.expect(response.job).to.eql(\"zion resident\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"morpheus\",\n  \"job\": \"zion resident\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Update user profile and verify both the updatedAt timestamp and the updated fields."
      },
      "response": []
    },
    {
      "name": "Patch User Field (PATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Verify patched field updated\", () => {",
              "    pm.expect(response.job).to.eql(\"zion resident\");",
              "});",
              "",
              "pm.test(\"Verify other fields were not changed\", () => {",
              "    pm.expect(response).to.not.have.property(\"name\");",
              "});",
              "",
              "pm.test(\"Verify updatedAt timestamp is present\", () => {",
              "    pm.expect(response).to.haveOwnProperty(\"updatedAt\");",
              "    pm.expect(response.updatedAt).not.to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"job\": \"zion resident\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Partially update user job and check that other fields were not modified."
      },
      "response": []
    },
    {
      "name": "Bad Request: Login Without Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Verify error message indicates missing password\", () => {",
              "    pm.expect(response).to.have.property(\"error\", \"Missing password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{storedUserEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Negative test sending login request using stored user email with missing password."
      },
      "response": []
    },
    {
      "name": "Bad Request: Register Without Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let response = pm.response.json();",
              "",
              "pm.test(\"Status code is 400 Bad Request\", () => {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Verify error message for missing registration password\", () => {",
              "    pm.expect(response).to.have.property(\"error\", \"Missing password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{storedUserEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Negative test registering using stored user email without providing password."
      },
      "response": []
    },
    {
      "name": "Bad Request: Non-Existent User ID",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let baseId = pm.collectionVariables.get(\"storedUserId\") || \"2\";",
              "pm.collectionVariables.set(\"invalidUserId\", baseId + \"999\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{invalidUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{invalidUserId}}"
          ]
        },
        "description": "Negative test requesting an invalid user ID derived dynamically from stored ID."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reqres.in/api"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "storedUserId",
      "value": "2"
    },
    {
      "key": "storedUserEmail",
      "value": "eve.holt@reqres.in"
    },
    {
      "key": "invalidUserId",
      "value": "2999"
    }
  ]
}